# Copy to .env and edit. docker compose reads this file automatically.
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=0
ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=http://localhost:8080,http://127.0.0.1:8080
PLUMBLINE_SEED=1
PLUMBLINE_SEED_SECRET=dev-seed-secret
PLUMBLINE_SITE_NAME=Plumbline
# your public address, with scheme; printed on certificates and in links you send
PLUMBLINE_SITE_URL=
PLUMBLINE_ANON_WRITE_RATE=20
# 1 only behind a reverse proxy you run that sets X-Forwarded-For
PLUMBLINE_TRUST_PROXY=0
# 1 if webhook receivers are on your own private network
PLUMBLINE_WEBHOOK_ALLOW_PRIVATE=0
GUNICORN_WORKERS=2
